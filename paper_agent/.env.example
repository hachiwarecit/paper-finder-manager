# paper_agent 環境変数サンプル
# このファイルを .env にコピーして値を設定してください。
# .env は git にコミットしないでください (.gitignore 済み)。

# ------------------------------------------------------------------
# Anthropic API (任意)
#   設定されている場合のみ、LLM による高度な同一データ判定や
#   カテゴリ分類の補助に利用する。未設定ならルールベースで動作する。
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------
# Unpaywall / OpenAlex は API キー不要だが、礼儀として
# 連絡先メールアドレス (polite pool) を入れることが推奨されている。
# ------------------------------------------------------------------
CONTACT_EMAIL=your-email@example.com

# OpenAlex polite pool 用 (CONTACT_EMAIL と同じで良い)
OPENALEX_MAILTO=your-email@example.com
